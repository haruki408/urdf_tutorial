<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel_d250_robot">

    <!-- Define a macro for the wheel -->
    <xacro:macro name="wheel_d250" params="name base_frame r p y" >
        <!-- Base link -->
         

        <joint name="${name}_joint" type="fixed">
            <parent link="${base_frame}"/>
            <child link="${name}_base_wheel_link"/>
            <origin xyz="0 0 0" rpy="${r} ${p} ${y}"/>
        </joint>

        <link name="${name}_base_wheel_link">
            <visual>
            <origin xyz="0 0 0" rpy="${pi/2} ${pi} 0" />
                <geometry>
                    <mesh filename="package://urdf_tutorial/stl/wheel_d250_with_connector.stl" scale="0.001 0.001 0.001"/> 
                </geometry>
                <material name="silver"/>
            </visual>
        </link>

        

    </xacro:macro>
</robot>