<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel_d250_robot">

  <!--
    wheel_d250 マクロ
    - name: このホイールの識別名
    - base_frame: 接続元リンク名
    - r,p,y: 回転角 (ラジアン)
    - x,y_pos,z: 親リンクからの位置 (m)
  -->
  <xacro:macro name="wheel_d250" params="name base_frame r p y x:=0.0 y_pos:=0.0 z:=0.0">

    <!-- 親リンクとの固定ジョイント -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${base_frame}"/>
      <child link="${name}_base_wheel_link"/>
      <!-- ★ 位置と姿勢 -->
      <origin xyz="${x} ${y_pos} ${z}" rpy="${r} ${p} ${y}"/>
    </joint>

    <!-- ベースリンク -->
    <link name="${name}_base_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} ${pi} 0"/>
        <geometry>
          <mesh filename="package://urdf_tutorial/stl/wheel_d250_with_connector.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
    </link>


  </xacro:macro>

</robot>
