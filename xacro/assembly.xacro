<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ms">
    <xacro:include filename="$(find urdf_tutorial)/xacro/limb.xacro" />
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>
    <xacro:limb prefix="limb1" />
</robot>