<?xml version="1.0"?>
<robot name="moonshot_palette_body" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find urdf_tutorial)/xacro/limb.xacro" />

    <!-- Define a macro for the limb -->
    <xacro:macro name="palette_body" params="name base_frame r p y">
        <!-- Base link -->

        <!-- Define some constants -->
        <xacro:property name="palette_body_length" value="0.5"/>
        <xacro:property name="palette_body_width" value="0.15"/>
        <xacro:property name="palette_body_height" value="0.15"/>
        <xacro:property name="palette_body_mass" value="5.0"/>

        <joint name="${name}_joint" type="fixed">
            <parent link="${base_frame}"/>
            <child link="palette_body_link"/>
            <origin xyz="0 0.23 0.165" rpy="${r} ${p} ${y}"/>
        </joint>

        <!-- Define the body link -->
        <link name="palette_body_link">
            <visual>
                <origin xyz="${-palette_body_length/2} ${-palette_body_width/2} ${-palette_body_height/2}" rpy="${pi/2} 0 ${-pi/2}"/>
                <geometry>
                    <mesh filename="package://urdf_tutorial/stl/body.stl" scale="0.0001 0.0001 0.0001"/>
                </geometry>
                <material name="black">
                    <color rgba="1 0 0 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="${palette_body_length} ${palette_body_width} ${palette_body_height}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="${palette_body_mass}"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
            </inertial>
        </link>

        <link name="palette_body_n_2_link_2"/>

        <joint name="palette_body_n_2_joint_2_" type="fixed">
            <parent link="palette_body_link"/>
            <child link="palette_body_n_2_link_2"/>
            <origin xyz="0.14 -0.075 0" rpy="0 0 ${-pi/2}"/>
        </joint>

   <xacro:limb name="body_n_2_limb_n_2" base_frame="palette_body_n_2_link_2" p="${90*pi/180}" y="${0*pi/180}" r="${0*pi/180}" />
 </xacro:macro>

</robot>
